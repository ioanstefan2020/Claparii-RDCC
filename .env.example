# ==============================================================================
# PRIMAZI — CONFIGURARE MODELE AI & FURNIZORI
# ==============================================================================

# Modelul activ:
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# DeepSeek Cloud
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Groq Cloud
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini
GEMINI_API_KEY=

# Local Ollama Daemon (dacă rulează)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Token Extensie Browser
EXTENSION_TOKEN=primazi-demo-2026

# Parametri de siguranță și cache
LLM_TIMEOUT_SECONDS=30
LLM_CACHE_DIR=.cache/llm
MAX_INPUT_CHARS=12000
LOG_CONTENT=false
