# Copy to .env (never commit .env). The app must run with LLM_PROVIDER=mock and NO keys.
LLM_PROVIDER=mock            # mock | gemini | deepseek
LLM_MODEL=                   # provider model id (set after the Romanian bake-off; see TASKS T1.2)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_CACHE_DIR=.cache/llm     # cached responses make the demo survive Wi-Fi / rate limits
MAX_INPUT_CHARS=12000
LOG_CONTENT=false            # NEVER log user documents
